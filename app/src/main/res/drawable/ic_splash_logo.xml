<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash mark: a stocked shelf, which is what this app is about.

  A deliberately simple geometric mark. It is shown drawn smaller, through
  drawable/ic_launcher_foreground.xml, as both the launcher icon and the splash
  icon, so the icon on the home screen and the splash it opens are the same
  picture. Replace it when there is a real brand asset.

  Not used at this size anywhere: the shelf's corners (24..84 on a 108dp canvas)
  fall outside the circle Android 12+ shows a splash icon through, and on a
  Samsung they were visibly cut off. Drawn white so it reads on the brand blue
  background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shelf unit -->
    <path
        android:fillColor="#00000000"
        android:pathData="M24,26 H84 V82 H24 Z"
        android:strokeColor="#FFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="4" />

    <!-- Shelves -->
    <path
        android:pathData="M24,45 H84"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3" />
    <path
        android:pathData="M24,64 H84"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3" />

    <!-- Stock, in varying heights so the mark reads as goods rather than a grid -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,32 h8 v13 h-8 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,29 h8 v16 h-8 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,34 h8 v11 h-8 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M66,31 h8 v14 h-8 z" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,51 h10 v13 h-10 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,49 h8 v15 h-8 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M56,53 h9 v11 h-9 z" />

    <!-- The bottom row carries a third block so the shelf reads as stocked rather
         than as having run out on one side. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,70 h11 v12 h-11 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M45,67 h9 v15 h-9 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M58,71 h16 v11 h-16 z" />
</vector>
